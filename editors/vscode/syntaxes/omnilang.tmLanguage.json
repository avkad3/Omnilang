{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated by `cargo xtask grammar` from crates/omni-core/packs. Do not edit by hand.",
  "name": "OmniLang",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:இருக்கும்வரை|இல்லையெனில்|திருப்பு|என்றால்|return|while|लौटाओ|else|वरना|जबतक|अगर|if|तो)(?![\\p{L}\\p{M}\\p{N}_])",
      "name": "keyword.control.omnilang"
    },
    {
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:செயல்பாடு|कार्य|fn)(?![\\p{L}\\p{M}\\p{N}_])",
      "name": "storage.type.function.omnilang"
    },
    {
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:स्थिर|நிலை|மாறி|let|var|चर)(?![\\p{L}\\p{M}\\p{N}_])",
      "name": "storage.modifier.omnilang"
    },
    {
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:அச்சிடு|print|छापो)(?![\\p{L}\\p{M}\\p{N}_])",
      "name": "support.function.builtin.omnilang"
    },
    {
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:false|असत्य|true|सत्य|மெய்|பொய்)(?![\\p{L}\\p{M}\\p{N}_])",
      "name": "constant.language.omnilang"
    },
    {
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:மற்றும்|அல்லது|नहीं|அல்ல|and|not|or|और|या)(?![\\p{L}\\p{M}\\p{N}_])",
      "name": "keyword.operator.word.omnilang"
    },
    {
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:पूर्णांक|தருக்கம்|तार्किक|முழுஎண்|bool|சரம்|int|str|पाठ)(?![\\p{L}\\p{M}\\p{N}_])",
      "name": "storage.type.omnilang"
    },
    {
      "match": "(?<![\\p{L}\\p{M}_])[0-9०-९௦-௯]+(?![\\p{L}\\p{M}_])",
      "name": "constant.numeric.omnilang"
    },
    {
      "match": "[\\p{L}_][\\p{L}\\p{M}\\p{N}_\\x{200C}\\x{200D}]*(?=\\s*\\()",
      "name": "entity.name.function.omnilang"
    },
    {
      "match": "[;।॥]",
      "name": "punctuation.terminator.omnilang"
    },
    {
      "match": "->|==|!=|<=|>=|&&|\\|\\||[-+*/%<>=!]",
      "name": "keyword.operator.omnilang"
    }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.omnilang"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.omnilang",
      "patterns": [
        {
          "match": "\\[nt\"\\]",
          "name": "constant.character.escape.omnilang"
        }
      ]
    }
  },
  "scopeName": "source.omnilang"
}
