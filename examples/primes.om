// अभाज्य संख्याएँ: 50 तक की सभी अभाज्य संख्याएँ छापो।
कार्य अभाज्य(न: पूर्णांक) -> तार्किक {
    अगर न < 2 तो {
        असत्य लौटाओ।
    }
    चर भाजक = 2।
    जबतक भाजक * भाजक <= न {
        अगर न % भाजक == 0 तो {
            असत्य लौटाओ।
        }
        भाजक = भाजक + 1।
    }
    सत्य लौटाओ।
}

कार्य मुख्य() {
    चर न = 1।
    चर गिनती = 0।
    जबतक न <= 50 {
        अगर अभाज्य(न) तो {
            न छापो।
            गिनती = गिनती + 1।
        }
        न = न + 1।
    }
    "कुल:", गिनती छापो।
}
