// Squares and a factorial, in Tamil.
செயல்பாடு வர்க்கம்(எ: முழுஎண்) -> முழுஎண் {
    எ * எ திருப்பு;
}

செயல்பாடு காரணீயம்(n: முழுஎண்) -> முழுஎண் {
    n <= 1 என்றால் {
        1 திருப்பு;
    }
    n * காரணீயம்(n - 1) திருப்பு;
}

செயல்பாடு முதன்மை() {
    மாறி i = 1;
    i <= 5 இருக்கும்வரை {
        i, வர்க்கம்(i) அச்சிடு;
        i = i + 1;
    }
    "20! =", காரணீயம்(20) அச்சிடு;
    i > 5 மற்றும் மெய் அச்சிடு;
}
